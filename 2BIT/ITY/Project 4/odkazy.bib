@thesis{hlavnickova,
abstract= {Bakalářská práce na téma Identifikace osob podle ručního písma je rozdělena do několika kapitol. První kapitola je zaměřena na historii vzniku písma a na jeho dnešní podobu. Druhá kapitola pojednává o písmoznalectví, o jeho historii a následně o identifikaci osob. Třetí kapitola se zabývá grafologií, především písmovými znaky. Čtvrtá kapitola ujasňuje vztah mezi grafologií a písmoznalectvím, a poslední kapitola obsahuje experiment, který má za cíl odpovědět na otázku, zda je odůvodněno neuznávání grafologie jako kriminalistické vědy.},
publisher = {Vysoká škola Regionálneho rozvoja},
year = {2017},
title = {Identifikace osob podle ručního písma},
copyright = {Bez omezení},
language = {cze},
